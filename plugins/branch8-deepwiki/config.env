# Branch8 settings for the branch8-deepwiki hooks.
#
# Ships with the plugin, so it reaches every account - including personal ones,
# which never receive the organisation's managed settings. An environment
# variable of the same name overrides a value here.
#
# Plain KEY=value lines only; values are read, not executed.

# GitHub organisation whose repos are indexed in Devin's DeepWiki
BRANCH8_DEEPWIKI_ORG=branch8

# Who to ask for a Devin account (shown to people who have none)
BRANCH8_DEEPWIKI_ADMIN=glenn@branch8.com
