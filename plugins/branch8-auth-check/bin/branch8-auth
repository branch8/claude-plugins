#!/usr/bin/env bash
# Local answers for the branch8-auth-check sign-in flow.
#   no-account <service>  remember the user has no account (stop showing/asking)
#   clear [service]       forget that answer (all services when none is given)
#   status                print recorded answers and the gh CLI state
#   config                print admin, GitHub org, Devin org id, settings.json path
#   service <name>        normalise a service name typed after /auth-check
#   server <service>      the MCP server of jira/devin to sign in to
#   check devin           test the Devin token now (env, else settings.json)
#   duplicates            hand-added Devin/DeepWiki MCP that hide branch8-deepwiki's
#   keep-duplicate        the user keeps theirs: stop flagging it
#   personal-dir          config dir for a personal account (moved MCP goes there)
#   login <service> [srv] sign in to that MCP server through `claude mcp login`

. "$(cd "$(dirname "$0")/.." && pwd)/hooks/lib.sh"

known() {
  case " $BA_SERVICES " in *" $1 "*) return 0 ;; esac
  echo "unknown service '$1' (one of: $BA_SERVICES)" >&2
  exit 2
}

case "$1" in
  no-account)
    known "$2"
    mkdir -p "$BA_NO_ACCOUNT_DIR" && date '+%F' > "$BA_NO_ACCOUNT_DIR/$2" && echo "recorded: no $2 account"
    ;;
  clear)
    if [ -n "$2" ]; then
      known "$2"
      rm -f "$BA_NO_ACCOUNT_DIR/$2"
      [ "$2" = devin ] && rm -f "$BA_KEEP_DUP"
    else
      rm -rf "$BA_NO_ACCOUNT_DIR"
      rm -f "$BA_KEEP_DUP"
    fi
    echo "cleared${2:+ $2}"
    ;;
  status)
    list=$(ba_no_account_list)
    echo "no-account: ${list:-none}"
    echo "gh: $(ba_gh_state)"
    ;;
  config)
    echo "admin=${BRANCH8_AUTH_ADMIN:-your Branch8 admin}"
    echo "github_org=${BRANCH8_GITHUB_ORG:-branch8}"
    echo "devin_org_id=${BRANCH8_DEVIN_ORG_ID:-(not set - ask the admin, or Devin > Settings > Devin API)}"
    echo "settings_file=$(ba_settings_file)"
    ;;
  service)
    ba_service_of "$2" || { echo "unknown service '$2' (one of: $BA_SERVICES)" >&2; exit 2; }
    ;;
  server)
    host=$(ba_mcp_host "$2") || { echo "no MCP sign-in for '$2' (jira, devin)" >&2; exit 2; }
    command -v claude >/dev/null 2>&1 || { echo "claude CLI not found" >&2; exit 5; }
    claude mcp list 2>/dev/null | ba_pick_server "$host"; rc=$?
    case "$rc" in
      3) echo "already connected" >&2 ;;
      4) echo "no $2 MCP server installed" >&2 ;;
    esac
    exit "$rc"
    ;;
  check)
    [ "$2" = devin ] || { echo "usage: branch8-auth check devin" >&2; exit 2; }
    # A token just written to settings.json is not in this session's
    # environment yet (read at start-up): fall back to the file.
    if [ -z "$DEVIN_API_KEY" ]; then
      DEVIN_API_KEY=$(ba_settings_env DEVIN_API_KEY)
      [ -z "$DEVIN_ORG_ID" ] && DEVIN_ORG_ID=$(ba_settings_env DEVIN_ORG_ID)
      export DEVIN_API_KEY DEVIN_ORG_ID
    fi
    state=$(ba_devin_check)
    echo "devin: $state"
    case "$state" in
      ok) exit 0 ;;
      unset) echo "DEVIN_API_KEY is not set in this session (settings.json env is read when a session starts)" >&2; exit 3 ;;
      rejected) echo "Devin refused the token or organisation id" >&2; exit 4 ;;
      *) echo "could not reach Devin (offline or timed out)" >&2; exit 5 ;;
    esac
    ;;
  duplicates)
    out=$(ba_mcp_duplicates)
    if [ -n "$out" ]; then printf '%s\n' "$out"; else echo "none"; fi
    ;;
  keep-duplicate)
    mkdir -p "$BA_STATE_DIR" && date '+%F' > "$BA_KEEP_DUP" && echo "recorded: keep hand-added Devin/DeepWiki MCP (stop asking)"
    ;;
  personal-dir)
    # Where a moved personal MCP goes: the config dir for a personal account.
    echo "${BRANCH8_PERSONAL_CONFIG_DIR:-$HOME/.claude-personal}"
    ;;
  login)
    server="$3"
    if [ -z "$server" ]; then
      server=$("$0" server "$2") || exit $?
    fi
    command -v script >/dev/null 2>&1 || { echo "script (pseudo-terminal) not found: use /mcp" >&2; exit 5; }
    log=$(mktemp)
    trap 'rm -f "$log"' EXIT
    ( ba_in_pty timeout 300 claude mcp login "$server" </dev/null >"$log" 2>&1 ) &
    pid=$!
    url=""
    for _ in $(seq 60); do
      url=$(sed -n '/visit:/,$p' "$log" | tr '\033\007' '  ' | grep -o 'https://[^[:space:]]*' | head -1)
      [ -n "$url" ] && break
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.5
    done
    if [ -n "$url" ]; then
      ba_open_url "$url"
      echo "server: $server"
      echo "url: $url"
    fi
    wait "$pid"; rc=$?
    result=$(tr '\033' ' ' <"$log" | grep -oE "(Authenticated|Couldn't complete authentication) [^.]*" | tail -1)
    echo "${result:-login ended with code $rc}"
    exit "$rc"
    ;;
  *)
    echo "usage: branch8-auth no-account <service>|clear [service]|status|config|service <name>|server <service>|check devin|duplicates|keep-duplicate|personal-dir|login <service> [server]" >&2
    exit 2
    ;;
esac
