# Branch8 settings for the branch8-jira-check hook.
#
# This file ships with the plugin, so it reaches every account - including
# personal ones, which never receive the organisation's managed settings.
# An environment variable of the same name overrides a value here, so an admin
# can change one through the "env" block of managed settings (organisation
# accounts only) without releasing a new plugin version.
#
# Plain KEY=value lines only; values are read, not executed.

# Claude organisation UUID: `claude auth status` -> orgId
BRANCH8_ORG_ID=a4a2aa1a-21cd-467f-af54-8253e2ed15d8

# The company Jira site; a Jira login elsewhere is flagged
BRANCH8_JIRA_SITE=https://branch8.atlassian.net

# Email domain expected on the Jira account
BRANCH8_EMAIL_DOMAIN=branch8.com

# git remotes matching this (extended regex, case-insensitive) mark a company project
BRANCH8_COMPANY_REMOTE_RE=github\.com[:/]branch8/

# Label of the one "config issue" per Jira project that lists its repos
BRANCH8_CONFIG_LABEL=claude-config

# Where new per-project folders are suggested: <root>/<PROJECT KEY>
BRANCH8_WORKSPACE_ROOT=~/Branch8
